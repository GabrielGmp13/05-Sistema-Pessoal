# Configuração pública do cliente Supabase. Não use service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Interface de cadastro público. Manter false até migração, SMTP, CAPTCHA,
# limites e testes de isolamento serem aprovados; o Auth remoto também deve bloquear signup.
NEXT_PUBLIC_PUBLIC_SIGNUP_ENABLED=false

# Somente no servidor. Necessária às API Routes de integração; nunca use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Aviso opcional de novos chamados. O registro no Supabase continua sendo a fonte da verdade.
RESEND_API_KEY=
SUPPORT_EMAIL_FROM=
SUPPORT_NOTIFICATION_EMAIL=

# Opcionais e somente do servidor: ativam importação automática na Biblioteca.
YOUTUBE_API_KEY=
TMDB_API_KEY=
GOOGLE_BOOKS_API_KEY=

# Opcional e exclusivo do servidor: habilita cotações sob demanda em Finanças.
BRAPI_TOKEN=

# OAuth Google server-side: YouTube playlists + sincronização bilateral da Agenda.
# O redirect deve ser exatamente https://SEU-DOMINIO/api/integracoes/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# AES-256-GCM: 32 bytes codificados em base64. Gere localmente e salve somente
# no ambiente seguro da Vercel/Windows; trocar a chave invalida tokens já cifrados.
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_MAPS_API_KEY=
